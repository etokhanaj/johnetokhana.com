{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-johnlm.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node scripts/build-johnlm.mjs && astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "gates": "npm run check && npm run lint && npm run test && npm run build",
    "evals:johnlm": "node evals/johnlm/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/netlify": "^8.2.5",
    "@astrojs/react": "^6.0.5",
    "@netlify/blobs": "^10.7.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "dotted-map": "3.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "thinking-orbs": "^0.3.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
