---
// A real quote. Never invent one.
// `who`: product copy or a line said in the product, shown in a box.
// `by`: someone else's words about the work, with who said it.
interface Props {
  who?: string;
  by?: string;
}
const { who, by } = Astro.props;
---

{
  by ? (
    <figure class="quote">
      <blockquote><slot /></blockquote>
      <figcaption>{by}</figcaption>
    </figure>
  ) : (
    <blockquote class="qbox">
      <p><slot /></p>
      <span class="who">{who}</span>
    </blockquote>
  )
}
