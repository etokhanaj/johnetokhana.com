---
// Hand-drawn sticker badges. Language taken from cassandratang.com's badges
// (flat die-cut colour, a thin inner keyline, light rounded lettering on top and
// bottom arcs, a detailed line illustration with solid black accents, small side
// ornaments), but every drawing here is our own.
import type { Sticker } from '../data/site';

interface Props {
  s: Sticker;
  uid?: string;
}
const { s, uid = s.id } = Astro.props;
const ink = '#141414';
const lw = 1.5;
const font = "ui-rounded, 'SF Pro Rounded', 'Nunito', system-ui, sans-serif";
const mono = "ui-monospace, 'SF Mono', Menlo, monospace";

// Arcs centred on (cx, cy): top reads left to right over the top, bottom reads
// left to right under the bottom with glyphs upright.
const top = (r: number, cx = 50, cy = 50) => `M${cx - r} ${cy} A${r} ${r} 0 0 1 ${cx + r} ${cy}`;
const bot = (r: number, cx = 50, cy = 50) => `M${cx - r} ${cy} A${r} ${r} 0 0 0 ${cx + r} ${cy}`;

const starburst = (() => {
  const p: string[] = [];
  const n = 18;
  for (let i = 0; i < n * 2; i++) {
    const r = i % 2 === 0 ? 48 : 41.5;
    const a = (Math.PI * i) / n - Math.PI / 2;
    p.push(`${(50 + r * Math.cos(a)).toFixed(2)},${(50 + r * Math.sin(a)).toFixed(2)}`);
  }
  return p.join(' ');
})();
const scallop = (() => {
  const p: string[] = [];
  for (let i = 0; i <= 360; i += 2) {
    const a = (i * Math.PI) / 180;
    const r = 45.5 + 2.4 * Math.cos(20 * a);
    p.push(`${(50 + r * Math.cos(a)).toFixed(2)},${(50 + r * Math.sin(a)).toFixed(2)}`);
  }
  return p.join(' ');
})();
const sparkle = (x: number, y: number, r = 4) =>
  `M${x} ${y - r} Q${x} ${y} ${x + r} ${y} Q${x} ${y} ${x} ${y + r} Q${x} ${y} ${x - r} ${y} Q${x} ${y} ${x} ${y - r} Z`;
---

<svg viewBox="0 0 100 100" role="img" aria-label={s.title}>
  <defs>
    <path id={`t-${uid}`} d={s.id === 'tennis' ? top(37, 50, 76) : s.id === 'gym' ? top(31) : s.id === 'burst' ? top(30) : top(33)} />
    <path id={`b-${uid}`} d={s.id === 'gym' ? bot(31) : s.id === 'burst' ? bot(30) : bot(33)} />
  </defs>

  {
    s.id === 'burst' && (
      <g>
        <polygon points={starburst} fill={s.color} />
        <circle cx="50" cy="50" r="38.6" fill="none" stroke={ink} stroke-width="1.2" />
        <text font-family={font} font-weight="700" font-size="7" letter-spacing="0.7" fill={ink}><textPath href={`#t-${uid}`} startOffset="50%" text-anchor="middle">BURST BUILDER</textPath></text>
        <text font-family={font} font-weight="700" font-size="7" letter-spacing="0.7" fill={ink} dy="5"><textPath href={`#b-${uid}`} startOffset="50%" text-anchor="middle">63% IN BURSTS</textPath></text>
        <path d="M53 33 L41 52 H49.5 L45.5 67 L59.5 46 H51 Z" fill="#fff" stroke={ink} stroke-width={lw} stroke-linejoin="round" />
        <path d="M38.5 41 l-4 -1.5 M37.5 47 l-4.5 0.2 M61.5 55 l4.5 0.8 M60 61 l4 2" stroke={ink} stroke-width={lw} stroke-linecap="round" />
        <path d={sparkle(21, 50, 3.6)} fill={ink} /><path d={sparkle(79, 50, 3.6)} fill={ink} />
      </g>
    )
  }

  {
    s.id === 'robots' && (
      <g>
        <circle cx="50" cy="50" r="48" fill={s.color} />
        <circle cx="50" cy="50" r="42.5" fill="none" stroke={ink} stroke-width={lw} />
        <text font-family={font} font-weight="600" font-size="8.6" letter-spacing="1.2" fill={ink}><textPath href={`#t-${uid}`} startOffset="50%" text-anchor="middle">DANCES WITH</textPath></text>
        <text font-family={font} font-weight="600" font-size="8.6" letter-spacing="1.6" fill={ink} dy="6.4"><textPath href={`#b-${uid}`} startOffset="50%" text-anchor="middle">ROBOTS</textPath></text>
        <g stroke={ink} stroke-width={lw} stroke-linecap="round" stroke-linejoin="round">
          <path d="M50 33.5 V38" /><circle cx="50" cy="31.5" r="2.2" fill="#fff" />
          <rect x="33.5" y="38" width="33" height="25" rx="8" fill="#fff" />
          <rect x="30" y="45" width="3.5" height="9" rx="1.6" fill="#fff" /><rect x="66.5" y="45" width="3.5" height="9" rx="1.6" fill="#fff" />
          <ellipse cx="43.5" cy="48.5" rx="3.6" ry="4.6" fill={ink} /><ellipse cx="56.5" cy="48.5" rx="3.6" ry="4.6" fill={ink} />
          <path d="M45.5 56.5 Q50 59.5 54.5 56.5" fill="none" />
          <path d="M33 67 l-4 5 M67 67 l4 5" />
        </g>
        <circle cx="42.4" cy="47" r="1.1" fill="#fff" /><circle cx="55.4" cy="47" r="1.1" fill="#fff" />
        <path d={sparkle(21, 50, 4)} fill="none" stroke={ink} stroke-width="1.2" stroke-linejoin="round" />
        <path d={sparkle(79, 50, 4)} fill="none" stroke={ink} stroke-width="1.2" stroke-linejoin="round" />
      </g>
    )
  }

  {
    s.id === 'tennis' && (
      <g>
        <path d="M3 74 A47 47 0 0 1 97 74 V77 Q97 83 91 83 H9 Q3 83 3 77 Z" fill={s.color} />
        <text font-family={font} font-weight="600" font-size="7.4" letter-spacing="0.8" fill={ink}><textPath href={`#t-${uid}`} startOffset="50%" text-anchor="middle">INNER DJOKOVIC</textPath></text>
        <g transform="translate(9 11) scale(0.82)">
        <g stroke={ink} stroke-width={lw} stroke-linecap="round" stroke-linejoin="round" transform="rotate(-38 48 60)">
          <clipPath id={`rk-${uid}`}><ellipse cx="48" cy="52" rx="8.5" ry="11" /></clipPath>
          <ellipse cx="48" cy="52" rx="8.5" ry="11" fill="#fff" />
          <g clip-path={`url(#rk-${uid})`} stroke-width="0.7">
            <path d="M42 40 V64 M45 40 V64 M48 40 V64 M51 40 V64 M54 40 V64 M38 45 H58 M38 48.5 H58 M38 52 H58 M38 55.5 H58 M38 59 H58" />
          </g>
          <ellipse cx="48" cy="52" rx="8.5" ry="11" fill="none" stroke-width="2.2" />
          <path d="M48 63 L46.8 67 H49.2 Z" fill={ink} />
          <rect x="46.4" y="67" width="3.2" height="11" rx="1.4" fill={ink} />
        </g>
        <circle cx="62.5" cy="62" r="5.4" fill="#fff" stroke={ink} stroke-width={lw} />
        <path d="M58.2 59 Q62 62 58.6 65.4 M66.8 58.6 Q63 62 66.4 65.2" fill="none" stroke={ink} stroke-width="1.1" stroke-linecap="round" />
        </g>
        <circle cx="14" cy="76" r="2.4" fill="none" stroke={ink} stroke-width="1.1" /><circle cx="86" cy="76" r="2.4" fill="none" stroke={ink} stroke-width="1.1" />
      </g>
    )
  }

  {
    s.id === 'games' && (
      <g>
        <path d="M12 94 V44 A38 38 0 0 1 88 44 V94 Q88 98 84 98 H16 Q12 98 12 94 Z" fill={s.color} />
        <path d="M17 93 V44.5 A33 33 0 0 1 83 44.5 V93 Z" fill="none" stroke={ink} stroke-width={lw} stroke-linejoin="round" />
        <g stroke={ink} stroke-width={lw} stroke-linejoin="round">
          <g transform="rotate(-14 39 44)">
            <rect x="29" y="34" width="20" height="20" rx="4.5" fill="#fff" />
            <circle cx="34" cy="39" r="1.7" fill={ink} stroke="none" /><circle cx="39" cy="44" r="1.7" fill={ink} stroke="none" /><circle cx="44" cy="49" r="1.7" fill={ink} stroke="none" />
          </g>
          <g transform="rotate(12 61 46)">
            <rect x="51" y="36" width="20" height="20" rx="4.5" fill="#fff" />
            <circle cx="56" cy="41" r="1.7" fill={ink} stroke="none" /><circle cx="66" cy="41" r="1.7" fill={ink} stroke="none" /><circle cx="56" cy="51" r="1.7" fill={ink} stroke="none" /><circle cx="66" cy="51" r="1.7" fill={ink} stroke="none" />
          </g>
          <path d="M27 28 l-3 -3 M33 25 l-1 -4 M71 27 l3 -3 M66 24 l1 -4" stroke-linecap="round" fill="none" />
        </g>
        <text x="50" y="74" text-anchor="middle" font-family={mono} font-weight="600" font-size="10.5" letter-spacing="0.6" fill={ink}>GAMES</text>
        <text x="50" y="86" text-anchor="middle" font-family={mono} font-weight="600" font-size="10.5" letter-spacing="0.6" fill={ink}>NIGHT</text>
      </g>
    )
  }

  {
    s.id === 'gym' && (
      <g>
        <polygon points={scallop} fill={s.color} />
        <circle cx="50" cy="50" r="27" fill="none" stroke={ink} stroke-width="1.1" />
        <text font-family={font} font-weight="700" font-size="7.6" letter-spacing="0.9" fill={ink}><textPath href={`#t-${uid}`} startOffset="50%" text-anchor="middle">6AM CLUB</textPath></text>
        <text font-family={font} font-weight="700" font-size="6.6" letter-spacing="0.6" fill={ink} dy="5"><textPath href={`#b-${uid}`} startOffset="50%" text-anchor="middle">GYM FIRST</textPath></text>
        <g stroke={ink} stroke-width={lw} stroke-linecap="round" stroke-linejoin="round">
          <path d="M50 33 V36.5 M38.5 38 l2.4 2.4 M61.5 38 l-2.4 2.4 M33.5 47.5 h3.4 M66.5 47.5 h-3.4" />
          <path d="M38 53 A12 12 0 0 1 62 53 Z" fill="#fff" />
          <path d="M44 47.6 q1.6 1.6 3.2 0 M52.8 47.6 q1.6 1.6 3.2 0" fill="none" />
          <path d="M31 53 H69" />
          <path d="M42 61.5 H58" />
          <rect x="38" y="57" width="4" height="9" rx="1.2" fill={ink} /><rect x="58" y="57" width="4" height="9" rx="1.2" fill={ink} />
          <rect x="35" y="58.8" width="3" height="5.4" rx="1" fill="#fff" /><rect x="62" y="58.8" width="3" height="5.4" rx="1" fill="#fff" />
        </g>
        <path d={sparkle(19, 50, 3)} fill={ink} /><path d={sparkle(81, 50, 3)} fill={ink} />
      </g>
    )
  }
</svg>
